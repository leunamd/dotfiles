// ============================================================
// Niri config — migrated from Hyprland
// Place at: ~/.config/niri/config.kdl
//
// Notable differences from Hyprland:
//  - Layout is scrollable columns, not master-stack.
//    Mod+, / Mod+. consume/expel windows into columns.
//    Mod+H/L resize the focused column width by 1%.
//  - Workspaces are dynamic and per-output (not global).
//    Mod+1..9 targets the focused monitor's workspaces.
//  - xwayland-satellite is spawned first; DISPLAY=:0 is exported.
// ============================================================
prefer-no-csd
// ── Input ────────────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "it"
        }
        numlock
    }

    mouse {
        // sensitivity=0 in Hyprland = no accel modification (niri default)
    }

    // Mirrors follow_mouse=1
    focus-follows-mouse max-scroll-amount="10%"
    // Uncomment to warp cursor to newly focused windows:
    // warp-mouse-to-focus
}

// ── Outputs ───────────────────────────────────────────────────
// Run `niri msg outputs` to verify connector names.

output "DP-1" {
    mode "2560x1440@180.0"
    position x=1920 y=0
    scale 1.0
    focus-at-startup
}

output "DP-3" {
    mode "1920x1080@144.0"
    position x=0 y=0
    scale 1.0
}

// ── Layout ───────────────────────────────────────────────────

layout {
    gaps 0

    // focus-ring is the indicator on the active window.
    // Maps to col.active_border / col.inactive_border from Hyprland.
    focus-ring {
        width 1
        active-gradient from="#33ccffee" to="#00ff99ee" angle=45
        inactive-color "#595959aa"
    }

    // No always-on border (matches gaps_in=0, gaps_out=0 minimal style)
    border {
        off
    }

    // 50% default column width mirrors mfact=0.5
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
}

// ── Environment Variables ─────────────────────────────────────

environment {
    XCURSOR_SIZE "24"
    WLR_RENDERER "vulkan"
    LIBVA_DRIVER_NAME "radeonsi"
    GTK_THEME "Adwaita:dark"
    XDG_SESSION_TYPE "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    OGL_DEDICATED_HW_STATE_PER_CONTEXT "ENABLE_ROBUST"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "qt6ct"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    _JAVA_AWT_WM_NONREPARENTING "1"
}

// ── Startup ──────────────────────────────────────────────────
// xwayland-satellite must come first so DISPLAY=:0 is ready.

spawn-at-startup "xwayland-satellite"

// GTK theming
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "color-scheme" "prefer-dark"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "gtk-theme" "adw-gtk3"

// Audio defaults
spawn-at-startup "sh" "-c" "pactl set-source-volume @DEFAULT_SOURCE@ 90%"
spawn-at-startup "sh" "-c" "pactl set-sink-volume @DEFAULT_SINK@ 50%"

// Background / tray services
spawn-at-startup "waybar" "--config" "/home/manuel/.config/waybar/config-niri.jsonc"
spawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/arch_linux.png"
spawn-at-startup "lxpolkit"
spawn-at-startup "dunst"
//spawn-at-startup "sh" "-c" "rm -f ~/hypridle.log && hypridle --config ~/.config/hypr/hypridle-niri.conf >> ~/hypridle.log 2>&1"
spawn-at-startup "sh" "-c" "rm -f ~/swayidle.log && swayidle -d -w lock 'pidof swaylock >/dev/null || swaylock -c 000000 -e -n -f; sleep 2; niri msg outputs | grep -q Disabled || niri msg action power-off-monitors' unlock 'niri msg action power-on-monitors; [ -f /tmp/discord-afk.pid ] && kill -USR2 $(cat /tmp/discord-afk.pid)' timeout 15 'pidof swaylock >/dev/null && niri msg action power-off-monitors' timeout 300 'discord_afk' timeout 310 'loginctl lock-session' timeout 350 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep 'loginctl lock-session' after-resume 'niri msg action power-on-monitors' >> ~/swayidle.log 2>&1"
spawn-at-startup "sh" "-c" "~/scripts/inhibitor-monitor.sh"
spawn-at-startup "sh" "-c" "python3 ~/scripts/discord-afk-daemon.py >> ~/discord-afk.log 2>&1"
spawn-at-startup "nm-applet"
spawn-at-startup "blueman-applet"
spawn-at-startup "sh" "-c" "rm -f ~/.hplip/hp-systray.lock && hp-systray"
spawn-at-startup "solaar" "--window=hide"
spawn-at-startup "joystickwake"
spawn-at-startup "sunsetr"

// User apps
spawn-at-startup "discord"
spawn-at-startup "spotify"
spawn-at-startup "lutris"
spawn-at-startup "discover-overlay"
spawn-at-startup "start-tmux"
spawn-at-startup "telecamera"
spawn-at-startup "google-chrome-stable"
spawn-at-startup "brave"
spawn-at-startup "com.stremio.stremio"

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}
// ── Keybinds ─────────────────────────────────────────────────
// "Mod" = Super (same as $mainMod = SUPER in Hyprland)

binds {
    // Mod-Shift-/, which is usually the same as Mod-?,
    // shows a list of important hotkeys.
    Mod+Shift+Apostrophe { show-hotkey-overlay; }
    // ── Screenshot ────────────────────────────────────────────
    // Region select → save to ~/Pictures/Screenshots/ and copy to clipboard
    //Print { spawn-sh "grim -g \"$(slurp -d)\" - | tee \"$HOME/Pictures/Screenshots/$(date +'%Y-%m-%d_%H-%M-%S').png\" | wl-copy"; }

    // ── Mic / Sink mute ───────────────────────────────────────
    Mod+Insert       { spawn-sh "pactl set-source-mute @DEFAULT_SOURCE@ toggle"; }
    Mod+Shift+Insert { spawn-sh "pactl set-sink-mute @DEFAULT_SINK@ toggle"; }

    // ── App launchers ─────────────────────────────────────────
    // Suggested binds for running programs: terminal, app launcher, screen locker.
    Mod+Shift+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+C            { spawn "google-chrome-stable"; }
    Mod+Z            { spawn "nautilus"; }
    Mod+P  hotkey-overlay-title="Run an Application: fuzzel" { spawn-sh "pkill fuzzel || fuzzel --list-executables-in-path --keyboard-focus=on-demand --background=161c24ff --selection-color=ffdf00ff"; }
    
    //Session
    Mod+Alt+L hotkey-overlay-title="Lock the Screen" { spawn-sh "loginctl lock-session"; }
    // quit shows a confirmation dialog
    Mod+Shift+Q { quit; }


    // Open/close the Overview: a zoomed-out view of workspaces and windows.
    // You can also move the mouse into the top-left hot corner,
    // or do a four-finger swipe up on a touchpad.
    Mod+O repeat=false { toggle-overview; }



    // ── Window management ─────────────────────────────────────
    Mod+Shift+C  repeat=false { close-window; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Up    { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Alternative commands that move across workspaces when reaching
    // the first or last window in a column.
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // ...

    // And you can also move a whole workspace to another monitor:
    Mod+Shift+Alt+Left     { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Right    { move-workspace-to-monitor-right; }

    // ...

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // You can bind mouse wheel scroll ticks using the following syntax.
    // These binds will change direction based on the natural-scroll setting.
    //
    // To avoid scrolling through workspaces really fast, you can use
    // the cooldown-ms property. The bind will be rate-limited to this value.
    // You can set a cooldown on any bind, but it's most useful for the wheel.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling; these binds replicate that.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Similarly, you can bind touchpad scroll "ticks".
    // Touchpad scrolling is continuous, so for these binds it is split into
    // discrete intervals.
    // These binds are also affected by touchpad's natural-scroll, so these
    // example binds are "inverted", since we have natural-scroll enabled for
    // touchpads by default.
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // You can refer to workspaces by index. However, keep in mind that
    // niri is a dynamic workspace system, so these commands are kind of
    // "best effort". Trying to refer to a workspace index bigger than
    // the current workspace count will instead refer to the bottommost
    // (empty) workspace.
    //
    // For example, with 2 workspaces + 1 empty, indices 3, 4, 5 and so on
    // will all refer to the 3rd workspace.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // Switches focus between the current and the previous workspace.
    // Mod+Tab { focus-workspace-previous; }

    // The following binds move the focused window in and out of a column.
    // If the window is alone, they will consume it into the nearby column to the side.
    // If the window is already in a column, they will expel it out.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }
    // Expel the bottom window from the focused column to the right.
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    // Cycling through the presets in reverse order is also possible.
    // Mod+R { switch-preset-column-width-back; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }

    // While maximize-column leaves gaps and borders around the window,
    // maximize-window-to-edges doesn't: the window expands to the edges of the screen.
    // This bind corresponds to normal window maximizing,
    // e.g. by double-clicking on the titlebar.
    Mod+M { maximize-column; }

    // Expand the focused column to space not taken up by other fully visible columns.
    // Makes the column "fill the rest of the space".
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+Alt+C { center-column; }

    // Center all fully visible columns on screen.
    Mod+Ctrl+C { center-visible-columns; }

    // Finer width adjustments.
    // This command can also:
    // * set width in pixels: "1000"
    // * adjust width in pixels: "-5" or "+5"
    // * set width as a percentage of screen width: "25%"
    // * adjust width as a percentage of screen width: "-10%" or "+10%"
    // Pixel sizes use logical, or scaled, pixels. I.e. on an output with scale 2.0,
    // set-column-width "100" will make the column occupy 200 physical screen pixels.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Plus { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Plus { set-window-height "+10%"; }

    // Move the focused window between the floating and the tiling layout.
    Mod+T       { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }

    // Toggle tabbed column display mode.
    // Windows in this column will appear as vertical tabs,
    // rather than stacked on top of each other.
    Mod+W { toggle-column-tabbed-display; }

    // Actions to switch layouts.
    // Note: if you uncomment these, make sure you do NOT have
    // a matching layout switch hotkey configured in xkb options above.
    // Having both at once on the same hotkey will break the switching,
    // since it will switch twice upon pressing the hotkey (once by xkb, once by niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Print { screenshot show-pointer=false; }
    Ctrl+Print { screenshot-screen show-pointer=false; }
    Alt+Print { screenshot-window; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ── Discover overlay ──────────────────────────────────────
    //Mod+Page_Up   { spawn "discover-overlay" "--rpc" "--show"; }
    //Mod+Page_Down { spawn "discover-overlay" "--rpc" "--hide"; }

    // ── Elveron shop ──────────────────────────────────────────
    Mod+F8 { spawn "elveron-shop"; }

    // Example media keys mapping using playerctl.
    // This will work with any MPRIS-enabled media player.
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    // ── Spotify — play/prev/next ──────────────────────────────
    Ctrl+Alt+KP_Enter { spawn "playerctl" "play-pause" "--player=spotify"; }
    Ctrl+Alt+KP_4     { spawn "playerctl" "previous"   "--player=spotify"; }
    Ctrl+Alt+KP_Left  { spawn "playerctl" "previous"   "--player=spotify"; }
    Ctrl+Alt+KP_6     { spawn "playerctl" "next"       "--player=spotify"; }
    Ctrl+Alt+KP_Right { spawn "playerctl" "next"       "--player=spotify"; }

    // ── Spotify — seek ────────────────────────────────────────
    Ctrl+Alt+KP_7       { spawn "playerctl" "position" "20-" "--player=spotify"; }
    Ctrl+Alt+KP_Home    { spawn "playerctl" "position" "20-" "--player=spotify"; }
    Ctrl+Alt+KP_9       { spawn "playerctl" "position" "20+" "--player=spotify"; }
    Ctrl+Alt+KP_Page_Up { spawn "playerctl" "position" "20+" "--player=spotify"; }

    // ── Volume ────────────────────────────────────────────────
    Ctrl+Alt+KP_1         { spawn "amixer" "set" "Master" "2%-"; }
    Ctrl+Alt+KP_End       { spawn "amixer" "set" "Master" "2%-"; }
    Ctrl+Alt+KP_3         { spawn "amixer" "set" "Master" "2%+"; }
    Ctrl+Alt+KP_Page_Down { spawn "amixer" "set" "Master" "2%+"; }

    // ── Generic play-pause (non-Spotify) ─────────────────────
    Ctrl+Alt+KP_0      { spawn "playerctl" "play-pause" "--ignore-player=spotify"; }
    Ctrl+Alt+KP_Insert { spawn "playerctl" "play-pause" "--ignore-player=spotify"; }
}

// ── Window Rules ─────────────────────────────────────────────
// Each window-rule is a separate block.
// Multiple match lines within a block are ANDed together.
// Strings are substring matches; wrap in r#"^...$"# for regex.

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
workspace "social" {
    open-on-output "DP-3"
}
workspace "crypto" {
    open-on-output "DP-3"
}
workspace "media" {
    open-on-output "DP-3"
}
workspace "browser" {
    open-on-output "DP-1"
}
workspace "gaming" {
    open-on-output "DP-1"
}

window-rule {
    match app-id=r#"^google-chrome$"#
    open-maximized-to-edges false
}
window-rule {
    match at-startup=true app-id=r#"^google-chrome$"#
    open-on-workspace "browser"
    open-maximized-to-edges true
}
window-rule {
    match app-id=r#"^brave-browser$"#
    open-maximized-to-edges false
    open-focused true
}
window-rule {
    match at-startup=true app-id=r#"^brave-browser$"#
    open-on-workspace "crypto"
    open-maximized-to-edges true
    open-focused false
}
// Block out mako notifications from screencasts.
layer-rule {
    match namespace="^notifications$"

    block-out-from "screencast"
}
layer-rule {
	match namespace="notifications"
	match namespace="fuzzel"

	shadow { on; }
}
// PulseAudio volume control
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
}

// File pickers (xdg-desktop-portal-gtk)
window-rule {
    match app-id="xdg-desktop-portal-gtk"
    match title="All Files"
    open-floating true
}
window-rule {
    match app-id="xdg-desktop-portal-gtk"
    match title="Open Files"
    open-floating true
}

// Chrome PWA / app windows
window-rule {
    match app-id=r#"^chrome-"#
    open-floating true
}

// ── Workspace 3 — Social ─────────────────────────────────────
window-rule {
    match app-id="discord"
    open-on-workspace "social"
    open-maximized-to-edges true
    open-focused false
}
window-rule {
    match at-startup=true app-id="discord"
    open-on-workspace "social"
    open-maximized-to-edges true
    open-focused true
}
window-rule {
    match app-id="vesktop"
    open-on-workspace "social"
    open-focused false
}
window-rule {
    match app-id="org.telegram.desktop"
    exclude title="^Media viewer$"
    open-on-workspace "social"
    open-maximized-to-edges true
    open-focused false
    open-floating false
}
// Telegram media viewer stays floating
//window-rule {
//    match app-id="org.telegram.desktop" title="Media viewer"
//    open-on-workspace "social"
//    open-floating true
//    open-maximized-to-edges false
//    open-focused true
//}

// ── Workspace 4 — Music ──────────────────────────────────────
window-rule {
    match app-id=r#"^[Ss]potify$"#
    open-on-workspace "social"
    open-maximized-to-edges true
    open-focused false
}
window-rule {
    match title="Spotify Free"
    open-on-workspace "social"
    open-maximized-to-edges true
    open-focused false
}

// ── Workspace 5 — Games ──────────────────────────────────────
window-rule {
    match app-id="upc.exe"
    open-on-workspace "gaming"
    open-focused false
}
window-rule {
    match app-id="xdefiant.exe"
    open-on-workspace "gaming"
    open-focused false
}
window-rule {
    match app-id="elveron-launcher.exe"
    open-on-workspace "gaming"
    open-focused false
}
window-rule {
    match app-id="elveron.exe"
    open-on-workspace "gaming"
    open-focused false
}
window-rule {
    match title="Elveron Launcher"
    open-on-workspace "gaming"
    open-focused false
//  open-floating true
}
// Elveron game window via Steam
window-rule {
    match app-id=r#"^steam_app_default$"#
    match title=r#"^Elveron$"#
    open-on-workspace "gaming"
    open-floating false
    open-focused false
}
// Elveron tk splash via Steam
window-rule {
    match app-id=r#"^steam_app_default$"#
    match title=r#"^tk$"#
    open-on-workspace "gaming"
    open-focused false
    //open-floating true
}
// Generic Steam game windows
window-rule {
    match app-id=r#"^steam_app_default$"#
    open-on-workspace "gaming"
    open-focused false
}

// ── Workspace 6 — Media ──────────────────────────────────────
window-rule {
    match at-startup=true app-id="mpv"
    open-on-workspace "media"
    open-focused false
    open-maximized-to-edges true
}
window-rule {
    match app-id="mpv"
    open-on-workspace "browser"
    open-focused true
    open-maximized-to-edges false
    open-fullscreen true
}
window-rule {
    match app-id="ffplay"
    open-on-workspace "media"
    open-focused false
    open-maximized-to-edges true
}
window-rule {
    match at-startup=true app-id="com.stremio.stremio"
    open-on-workspace "media"
    open-focused false
    open-maximized-to-edges true
}

window-rule {
    match app-id="com.stremio.stremio"
    open-on-workspace "media"
    open-focused true
    open-maximized-to-edges true
}

// ── Workspace 7 — Dev / VMs ──────────────────────────────────
window-rule {
    match app-id="virt-manager"
    open-on-workspace "7"
}
window-rule {
    match app-id="code-url-handler"
    open-on-workspace "7"
}
window-rule {
    match app-id="Waydroid"
    open-on-workspace "7"
    open-floating true
}

// ── Workspace 8 — Warframe / EVE ─────────────────────────────
window-rule {
    match title="Warframe"
    open-on-workspace "8"
}
window-rule {
    match title="EVE"
    open-on-workspace "8"
    open-fullscreen true
}

// ── Workspace 9 — Steam / Lutris ─────────────────────────────
window-rule {
    match app-id=r#"^[Ss]team$"#
    open-on-workspace "gaming"
}
window-rule {
    match title=r#"^[Ss]team$"#
    open-on-workspace "gaming"
}
window-rule {
    match app-id="net.lutris.Lutris"
    open-on-workspace "gaming"
}
window-rule {
    match app-id="BoltLauncher"
    open-on-workspace "gaming"
}
window-rule {
    match app-id=r"^net-runelite-client-RuneLite" title=r"^([^R]|R([^u]|$)|Ru([^n]|$)|Run([^e]|$)|Rune([^L]|$)|RuneL([^i]|$)|RuneLi([^t]|$)|RuneLit([^e]|$))"
    open-on-workspace "gaming"
    open-maximized-to-edges false
    open-floating true
}
window-rule {
    match app-id=r"^net-runelite-client-RuneLite" title=r"^RuneLite"
    open-on-workspace "gaming"
    open-maximized-to-edges true
}
window-rule {
    match app-id="steam_app_8500"
    open-on-workspace "gaming"
}
// EVE Launcher (floating)
window-rule {
    match title="EVE Launcher"
    open-on-workspace "gaming"
    open-floating true
}

// ── Misc floating ─────────────────────────────────────────────
window-rule {
    match title="AlecaFrame"
    open-floating true
}
window-rule {
    match app-id="shop-ocr"
    open-floating true
}

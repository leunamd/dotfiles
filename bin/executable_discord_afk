#!/bin/bash
# Move to AFK channel
if pactl list sink-inputs | grep -q 'application.process.binary = "Discord"'; then
	discover-overlay --rpc --moveto=1270288233481375774
	
	default_source=$(pactl get-default-source)
	mute_status=$(pactl get-source-mute "$default_source")
	if echo "$mute_status" | grep -q "no"; then
		sleep 1
		# Deaf yourself in Discord
		discover-overlay --rpc --deaf
	fi
fi

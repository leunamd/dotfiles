#!/bin/bash

# Check the session type
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    SDL_VIDEO_ALLOW_SCREENSAVER=1 ffplay -an -fflags nobuffer -fflags discardcorrupt -flags low_delay rtsp://192.168.0.27/ch0_0.h264
else
    SDL_VIDEO_ALLOW_SCREENSAVER=1 ffplay -an -fflags nobuffer -fflags discardcorrupt -flags low_delay -hwaccel cuda rtsp://192.168.0.27/ch0_0.h264
fi
